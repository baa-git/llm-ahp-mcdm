OPENROUTER_KEY_CLAUDE_SONNET_4_6=
OPENROUTER_KEY_DEEPSEEK_V3_2=
OPENROUTER_KEY_GEMINI_FLASH=
OPENROUTER_KEY_GLM_5=
OPENROUTER_KEY_GPT_4O=
OPENROUTER_KEY_GPT_5_2=
OPENROUTER_KEY_MINIMAX_M2_5=
OPENROUTER_KEY_QWEN3_5_397B=
# Judge model of the revision phase (revise --judge):
OPENROUTER_KEY_JUDGE=
